# Public origin used to validate same-origin browser mutations. Do not include
# a trailing path, query string, or fragment. Bind the production app behind a
# trusted reverse proxy before changing this to a public hostname.
APP_ORIGIN=http://localhost:3000

# Runtime connections should use a least-privilege role. The migration URL may
# use a separate schema-owner role; Compose passes it only to the migrate job.
DATABASE_URL=postgresql://cloud_health:change-me@db:5432/cloud_health
MIGRATION_DATABASE_URL=postgresql://cloud_health:change-me@db:5432/cloud_health

# PostgreSQL container initialization. Replace POSTGRES_PASSWORD before any
# non-local deployment. These values are only consumed by Compose's db service.
POSTGRES_DB=cloud_health
POSTGRES_USER=cloud_health
POSTGRES_PASSWORD=change-me

# Application runtime limits. Values are validated at process startup.
LOG_LEVEL=info
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=45
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_GRACE_MS=25000
MAX_SERVICES=100
